        //             -e MYSQL_HOST=${HOST} \
        //             -e MYSQL_PORT=${PORT} \
        //             -e MYSQL_DB=${DB} \
        //             -e MYSQL_USER=${USER} \
        //             -e MYSQL_PASSWORD=${PSWD} \
        //             -e MYSQL_SSL_MODE=false \
